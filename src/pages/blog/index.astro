---
import Layout from '../../layouts/Layout.astro';
import { posts } from '../../data/posts';

const published = posts.filter(post => !post.draft).sort((a, b) => b.date.localeCompare(a.date));
const guides = published.filter(post => post.type === 'guide');
const records = published.filter(post => post.type !== 'guide');
const typeLabels = { engineering: '開發筆記', 'case-study': '技術案例', retrospective: '回顧', guide: '使用指南' };
const guideImages: Record<string, string> = {
  'multistream-hub-guide': '/images/guides/multistream/multistream-live-grid.png',
  'pobtools-installation-guide': '/images/guides/pobtools/pobtools-pob-main.png',
  'poe-market-zh-guide': '/images/guides/poe-market/poemarketzh-1-popup.png',
  'minecraft-mod-translation-guide': '/images/guides/minecraft/00-app-overview.png',
};
---

<Layout title="文章與使用指南 | 熊少愆" description="專案使用指南、工程決策、技術案例與開發回顧。">
  <header class="page-intro site-shell">
    <span class="kicker">Field notes / {published.length} articles</span>
    <h1>從使用方法，寫到決策背後。</h1>
    <p>公開工具需要能被正確使用，工程成果也需要留下原因。文章分成可照著操作的完整指南，以及記錄架構、取捨與失敗經驗的工作筆記。</p>
  </header>

  <section class="site-shell py-20">
    <div class="section-heading mb-10"><div><span class="kicker">Practical guides</span><h2>可以實際完成任務的指南</h2></div><p>安裝、設定、驗證與常見問題放在同一篇文章裡，不把重要步驟藏在零散說明中。</p></div>
    <div class="guide-lead-grid">
      {guides.slice(0, 3).map((post, index) => (
        <a class="guide-lead" href={`/blog/${post.slug}`}>
          <figure>{guideImages[post.slug] && <img src={guideImages[post.slug]} alt={`${post.project ?? post.title} 操作畫面`} loading={index === 0 ? 'eager' : 'lazy'} />}</figure>
          <div><span class="meta-label text-[var(--red)]">Guide {String(index + 1).padStart(2, '0')}</span><h2>{post.title}</h2><p>{post.excerpt}</p></div>
        </a>
      ))}
    </div>
  </section>

  <section class="border-y border-[var(--line-strong)] bg-[var(--surface)]">
    <div class="site-shell py-20">
      <div class="section-heading mb-4"><div><span class="kicker">All writing</span><h2>完整文章索引</h2></div><p>依發布時間排列，涵蓋公開指南、專案回顧與去識別化技術案例。</p></div>
      <div class="post-index">
        {[...guides.slice(3), ...records].sort((a, b) => b.date.localeCompare(a.date)).map(post => (
          <article><a class="post-row" href={`/blog/${post.slug}`}>
            <div class="font-mono text-xs text-[var(--quiet)]"><time>{post.date}</time><div class="mt-2 text-[var(--red)]">{post.type ? typeLabels[post.type] : '文章'}</div></div>
            <div><h2>{post.title}</h2><p>{post.excerpt}</p></div>
            <div class="flex flex-wrap content-start gap-1">{post.tags.slice(0, 4).map(tag => <span class="tag">{tag}</span>)}</div>
          </a></article>
        ))}
      </div>
    </div>
  </section>
</Layout>
