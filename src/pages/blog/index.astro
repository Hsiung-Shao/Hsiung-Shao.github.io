---
import Layout from '../../layouts/Layout.astro';
import { posts } from '../../data/posts';

const published = posts.filter(p => !p.draft).sort((a, b) => b.date.localeCompare(a.date));
---

<Layout title="部落格 | 熊少愆">
  <section class="max-w-3xl mx-auto px-6 py-16">
    <header class="mb-10">
      <h1 class="text-4xl font-bold mb-2">Blog</h1>
      <p class="text-sm text-[var(--color-text-secondary)]">從實作中整理出的技術筆記與設計心得。</p>
    </header>

    {published.length === 0 ? (
      <p class="text-[var(--color-text-secondary)]">尚未有已發佈的文章。草稿會先通過人工審閱再上架。</p>
    ) : (
      <ul class="space-y-6">
        {published.map(p => (
          <li>
            <a href={`/blog/${p.slug}`} class="block rounded-lg border border-[var(--color-card-border)] bg-[var(--color-card-bg)] p-6 hover:border-[var(--color-accent-cyan)] transition-colors">
              <div class="flex items-center gap-2 mb-2 text-xs text-[var(--color-text-secondary)]">
                <time>{p.date}</time>
                {p.project && <><span>·</span><span>{p.project}</span></>}
              </div>
              <h2 class="text-xl font-semibold mb-2">{p.title}</h2>
              <p class="text-sm text-[var(--color-text-secondary)] leading-relaxed">{p.excerpt}</p>
              {p.tags.length > 0 && (
                <div class="mt-3 flex flex-wrap gap-1">
                  {p.tags.map(t => <span class="text-xs px-2 py-0.5 rounded bg-[var(--color-bg-primary)]">#{t}</span>)}
                </div>
              )}
            </a>
          </li>
        ))}
      </ul>
    )}
  </section>
</Layout>
