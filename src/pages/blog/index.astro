---
import { Image } from 'astro:assets';
import Layout from '../../layouts/Layout.astro';
import FilterScript from '../../components/FilterScript.astro';
import { visiblePosts } from '../../data/posts';
import { products, imageFor } from '../../data/products';

const published = [...visiblePosts].sort((a, b) => b.date.localeCompare(a.date));
const guides = published.filter(post => post.type === 'guide');
const typeLabels: Record<string, string> = { guide: '教學', engineering: '開發筆記', retrospective: '回顧', 'case-study': '技術案例' };
const filters = ['all', 'guide', 'engineering', 'retrospective', 'case-study'].filter(type => type === 'all' || published.some(post => post.type === type));

// 有產品頁的工具教學用產品頁的首屏截圖當封面,依序排前三篇;其他教學只放文字連結
const productByProject = new Map(products.map(product => [product.name, product]));
const covered = guides
  .map(post => ({ post, product: productByProject.get(post.project ?? '') }))
  .filter(item => item.product?.hero.image)
  .slice(0, 3)
  .map(item => ({ ...item, image: imageFor(item.product!.hero.image)! }));
const coveredSlugs = new Set(covered.map(item => item.post.slug));
const otherGuides = guides.filter(post => !coveredSlugs.has(post.slug));
---

<Layout title="文章與使用教學 | 熊少愆" description="PoE 工具、MultiStream Hub、Minecraft MOD 翻譯工具的使用教學，還有做這些東西時的開發筆記。">
  <section class="page-head">
    <div class="wrap">
      <h1 class="h1">使用教學與開發筆記</h1>
      <p class="lede" style="max-width: 42em">工具怎麼裝、怎麼用，還有做的時候踩到的坑。教學會跟著工具改版更新，畫面跟你看到的不一樣就是我還沒更新，可以到 GitHub 跟我說。</p>
    </div>
  </section>

  <section style="padding-bottom: 80px">
    <div class="wrap">
      <div class="head-row" style="margin-bottom: 24px"><h2 class="h2" style="font-size: 28px">先看教學</h2><span class="mono note">{guides.length} 篇，照工具分</span></div>
      <div class="grid g3">
        {covered.map(({ post, product, image }) => (
          <a class="media-card" href={`/blog/${post.slug}`} style={`--p-accent: ${product!.accent}`}>
            <Image src={image} alt={`${product!.name} 畫面`} widths={[480, 960]} sizes="(max-width: 900px) 100vw, 380px" />
            <div class="media-body">
              <span class="ptag" style="font-weight: 600">{product!.name} · {post.date.slice(5)}</span>
              <h3 class="h3">{post.title.replace(/^[^：]+：/, '')}</h3>
              <p class="body" style="font-size: 14px">{post.excerpt}</p>
            </div>
          </a>
        ))}
      </div>
      {otherGuides.length > 0 && (
        <div style="display: flex; flex-wrap: wrap; gap: 12px 28px; margin-top: 24px; font-size: 15px">
          {otherGuides.map(post => <a class="more" href={`/blog/${post.slug}`} style="color: var(--ink)">{post.title}</a>)}
        </div>
      )}
    </div>
  </section>

  <section id="all-posts" class="sec alt">
    <div class="wrap">
      <div class="head-row" style="margin-bottom: 24px"><h2 class="h2" style="font-size: 28px">全部文章</h2><span class="mono note">共 <span data-filter-count>{published.length}</span> 篇，新的在上面</span></div>
      <div class="filters" data-filter-group="#all-posts" role="group" aria-label="依文章類型篩選" style="margin-bottom: 12px">
        {filters.map((type, index) => <button type="button" class="seg" data-filter={type} aria-pressed={index === 0 ? 'true' : 'false'}>{type === 'all' ? '全部' : typeLabels[type]}</button>)}
      </div>
      {published.map(post => (
        <a class="post-row" href={`/blog/${post.slug}`} data-filter-item data-tags={post.type ?? 'engineering'}>
          <div class="meta"><time datetime={post.date}>{post.date}</time><span>{typeLabels[post.type ?? 'engineering']}{post.draft ? ' · 草稿' : ''}</span></div>
          <div><div class="title">{post.title}</div><div class="excerpt">{post.excerpt}</div></div>
          <div class="proj">{post.project}</div>
        </a>
      ))}
    </div>
  </section>
  <FilterScript />
</Layout>
