---
import Layout from '../../layouts/Layout.astro';
import { posts } from '../../data/posts';
import { marked } from 'marked';

export async function getStaticPaths() {
  return posts.filter(post => !post.draft).map(post => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const headings = [...post.body.matchAll(/^##\s+(.+)$/gm)].map((match, index) => ({ id: `section-${index + 1}`, title: match[1].replace(/[`*_]/g, '') }));
let headingIndex = 0;
const html = (await marked.parse(post.body)).replace(/<h2>(.*?)<\/h2>/g, (_match, title) => `<h2 id="section-${++headingIndex}">${title}</h2>`);
---

<Layout title={`${post.title} | 熊少愆`} description={post.excerpt}>
  <header class="article-head border-b border-[var(--line-strong)]">
    <div class="content-shell py-16">
      <a class="meta-label text-[var(--blue)] no-underline" href="/blog">← 文章索引</a>
      <div class="mt-8 flex flex-wrap gap-3 text-xs text-[var(--quiet)]"><time>{post.date}</time>{post.project && <><span>/</span><span>{post.project}</span></>}</div>
      <h1>{post.title}</h1>
      <p>{post.excerpt}</p>
      <div class="mt-6 flex flex-wrap gap-1">{post.tags.map(tag => <span class="tag">{tag}</span>)}</div>
    </div>
  </header>
  <main class="site-shell py-16">
    <div class="article-shell">
      <aside class="article-toc" aria-label="文章章節">
        <span class="meta-label">On this page</span>
        <nav class="mt-3">{headings.map(heading => <a href={`#${heading.id}`}>{heading.title}</a>)}</nav>
      </aside>
      <article class="article-body" set:html={html}></article>
    </div>
  </main>
</Layout>
