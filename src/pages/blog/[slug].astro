---
import Layout from '../../layouts/Layout.astro';
import { visiblePosts } from '../../data/posts';
import { products } from '../../data/products';
import { readingMinutes } from '../../../scripts/lib/reading-time.mjs';
import { marked } from 'marked';

export async function getStaticPaths() {
  return visiblePosts.map(post => ({ params: { slug: post.slug }, props: { post } }));
}

const { post } = Astro.props;
const typeLabels: Record<string, string> = { guide: '教學', engineering: '開發筆記', retrospective: '回顧', 'case-study': '技術案例' };
const headings = [...post.body.matchAll(/^##\s+(.+)$/gm)].map((match, index) => ({ id: `section-${index + 1}`, title: match[1].replace(/[`*_]/g, '') }));
let headingIndex = 0;
const html = (await marked.parse(post.body)).replace(/<h2>(.*?)<\/h2>/g, (_match, title) => `<h2 id="section-${++headingIndex}">${title}</h2>`);
const minutes = readingMinutes(post.body);

// 這篇講的工具有介紹頁時,標頭放下載與介紹按鈕,主色跟著工具走
const product = products.find(candidate => candidate.name === post.project);
const primary = product?.ctas.find(cta => cta.primary);
const isExternal = (href: string) => /^https?:\/\//.test(href);

// 「接著可以看」:同類型的其他文章,最多兩篇
const related = visiblePosts
  .filter(candidate => candidate.slug !== post.slug && candidate.type === post.type)
  .sort((a, b) => b.date.localeCompare(a.date))
  .slice(0, 2);
const accentOf = (name?: string) => products.find(candidate => candidate.name === name)?.accent;
---

<Layout title={`${post.title} | 熊少愆`} description={post.excerpt} accent={product?.accent}>
  <section style="padding: 64px 0 56px; border-bottom: 1px solid var(--line)">
    <div class="wrap" style="max-width: 1012px">
      <a href="/blog" style="font-size: 14px; font-weight: 700; color: var(--quiet)">← 文章索引</a>
      <div class="mono" style="display: flex; flex-wrap: wrap; gap: 12px; margin-top: 28px; font-size: 13px; color: var(--quiet)">
        <span style="color: var(--p-accent); font-weight: 600">{typeLabels[post.type ?? 'engineering']}{post.project ? ` · ${post.project}` : ''}</span>
        <time datetime={post.date}>{post.date}</time>
        <span>約 {minutes} 分鐘</span>
        {post.draft && <span>草稿（只在開發伺服器顯示）</span>}
      </div>
      <h1 class="h1" style="margin-top: 16px; font-size: 44px; line-height: 1.3">{post.title}</h1>
      <p class="lede" style="font-size: 18px">{post.excerpt}</p>
      {product && (
        <div class="btns" style="margin-top: 28px">
          {primary && <a class="btn btn-main" href={primary.href} target={isExternal(primary.href) ? '_blank' : undefined} rel={isExternal(primary.href) ? 'noopener noreferrer' : undefined}>{primary.label}</a>}
          <a class="btn btn-sub" href={`/projects/${product.slug}`}>看 {product.name} 介紹</a>
        </div>
      )}
    </div>
  </section>

  <section style="padding: 56px 0 88px">
    <div class="wrap article-layout">
      <aside>
        {headings.length > 1 && (
          <div class="toc">
            <div class="mono note" style="font-size: 12px; margin-bottom: 12px">這篇的段落</div>
            <nav aria-label="文章段落">{headings.map(heading => <a href={`#${heading.id}`}>{heading.title}</a>)}</nav>
          </div>
        )}
      </aside>
      <article class="prose" set:html={html}></article>
    </div>
  </section>

  {related.length > 0 && (
    <section class="sec alt">
      <div class="wrap" style="max-width: 1012px">
        <h2 class="h2" style="font-size: 24px; margin-bottom: 24px">接著可以看</h2>
        <div class="grid auto">
          {related.map(item => (
            <a class="card" href={`/blog/${item.slug}`} style={accentOf(item.project) ? `--p-accent: ${accentOf(item.project)}` : undefined}>
              <span class="ptag">{typeLabels[item.type ?? 'engineering']}{item.project ? ` · ${item.project}` : ''}</span>
              <div style="margin-top: 10px; font-size: 18px; font-weight: 700; line-height: 1.5">{item.title}</div>
            </a>
          ))}
        </div>
        <p class="note" style="margin-top: 28px; font-size: 14px">內容有錯或畫面跟你看到的不一樣，到 <a href="https://github.com/Hsiung-Shao" target="_blank" rel="noopener noreferrer" style="color: var(--p-accent)">GitHub</a> 跟我說。</p>
      </div>
    </section>
  )}
</Layout>
