---
import ConceptLayout from '../../layouts/ConceptLayout.astro';
import ConceptScene from '../../components/react/ConceptScene';
---

<ConceptLayout variant="cinematic" title="風格 B：Cinematic Archive | 熊少愆" description="以全螢幕 Three.js 專案影像展覽為核心的沉浸式個人首頁概念。">
  <main class="cinematic-home">
    <ConceptScene variant="cinematic" client:load />
    <header class="cinematic-nav">
      <a href="/">HSIUNG<br />SHAO</a>
      <p>Independent software practice<br />Taiwan</p>
      <nav><a href="/projects">Work</a><a href="/blog">Notes</a><a href="/about">Profile</a></nav>
    </header>

    <section class="cinematic-hero">
      <div class="cinematic-count"><span>01</span><small>/ 03</small></div>
      <div class="cinematic-copy">
        <p>SELECTED SYSTEM · LIVE</p>
        <h1>MultiStream<br />Hub</h1>
        <div class="cinematic-meta"><span>React / Streaming / Interface</span><a href="/blog/multistream-hub-guide">進入專案 ↗</a></div>
      </div>
      <aside class="cinematic-statement">把多個直播、聊天室與收藏整合成一個真正可以操作的觀看空間。</aside>
      <div class="cinematic-reel" aria-label="其他精選專案">
        <span class="active">MULTISTREAM HUB</span><span>POBTOOLS</span><span>MINECRAFT MOD</span>
      </div>
    </section>

    <section class="cinematic-next">
      <p>Beyond the screen</p>
      <h2>不是展示技術，而是讓技術成為內容的空間。</h2>
      <a href="/projects">查看完整工作索引 ↗</a>
    </section>
  </main>
</ConceptLayout>
