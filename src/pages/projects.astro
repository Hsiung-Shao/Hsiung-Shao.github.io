---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import FilterScript from '../components/FilterScript.astro';
import { projects } from '../data/projects';
import { visiblePosts } from '../data/posts';
import { products, imageFor, snapshotFor, youtubeThumb } from '../data/products';

const statusText: Record<string, { label: string; color: string; group: string }> = {
  active: { label: '進行中', color: 'var(--accent)', group: 'current' },
  maintained: { label: '維護中', color: '#7fc0a8', group: 'current' },
  paused: { label: '暫停', color: 'var(--faint)', group: 'paused' },
  archived: { label: '已封存', color: 'var(--faint)', group: 'archived' },
};
const publicProjects = projects.filter(project => project.visibility === 'public');
const caseStudies = visiblePosts.filter(post => post.type === 'case-study');

// 有介紹頁的用截圖卡;Kumori 沒有截圖,用最新一首的 YouTube 縮圖
const featured = products.map(product => {
  const project = projects.find(candidate => candidate.id === product.projectId)!;
  const latestSong = product.songs?.[0];
  return {
    product,
    project,
    status: statusText[project.status],
    image: imageFor(product.hero.image),
    thumb: !product.hero.image && latestSong ? youtubeThumb(latestSong.youtubeId) : null,
    version: snapshotFor(product.projectId)?.recent[0]?.tag ?? (product.songs ? `${product.songs.length} 首` : project.link ? '線上' : ''),
  };
});
const featuredIds = new Set(products.map(product => product.projectId));
const order = ['active', 'maintained', 'paused', 'archived'];
const others = publicProjects
  .filter(project => !featuredIds.has(project.id) && order.includes(project.status))
  .sort((a, b) => order.indexOf(a.status) - order.indexOf(b.status))
  .map(project => {
    const article = project.articles.find(slug => visiblePosts.some(post => post.slug === slug));
    const post = article ? visiblePosts.find(candidate => candidate.slug === article) : undefined;
    return { project, status: statusText[project.status], href: article ? `/blog/${article}` : project.link, cta: post?.type === 'guide' ? '看教學' : article ? '讀文章' : project.link ? '打開' : null };
  });
const filters = [
  { value: 'current', label: '還在做的' },
  { value: 'paused', label: '暫停' },
  { value: 'archived', label: '已封存' },
  { value: 'all', label: '全部' },
].filter(filter => filter.value === 'all' || filter.value === 'current' || others.some(item => item.status.group === filter.value));
---

<Layout title="全部專案 | 熊少愆" description="熊少愆的公開專案：PoE 繁中工具、MultiStream Hub、Kumori Music，還有暫停和已封存的專案。">
  <section class="page-head">
    <div class="wrap">
      <h1 class="h1">全部專案</h1>
      <p class="lede" style="max-width: 42em">{projects.length} 個專案，有在用的、做到一半先停的、已經收起來的都列在這裡。有獨立介紹頁的點進去看得到截圖和下載。</p>
      <div class="filters" data-filter-group="#project-list" role="group" aria-label="依專案狀態篩選" style="margin-top: 32px">
        {filters.map((filter, index) => <button type="button" class="seg" data-filter={filter.value} aria-pressed={index === filters.length - 1 ? 'true' : 'false'}>{filter.label}</button>)}
      </div>
    </div>
  </section>

  <div id="project-list">
    <section data-filter-section style="padding-bottom: 72px">
      <div class="wrap">
        <h2 class="h2" style="font-size: 28px; margin-bottom: 24px">有介紹頁的專案</h2>
        <div class="grid g3">
          {featured.map(item => (
            <a class="media-card" href={`/projects/${item.product.slug}`} data-filter-item data-tags={item.status.group} style={`--p-accent: ${item.product.accent}`}>
              {item.image && <Image src={item.image} alt={`${item.product.name} 畫面`} widths={[480, 960]} sizes="(max-width: 900px) 100vw, 380px" />}
              {item.thumb && <img src={item.thumb} alt={`${item.product.name} 最新一首歌的縮圖`} width="480" height="360" loading="lazy" />}
              <div class="media-body">
                <div style="display: flex; justify-content: space-between; align-items: center"><span class="status-dot" style={`color: ${item.status.color}`}>● {item.status.label}</span><span class="mono note" style="font-size: 12px">{item.version}</span></div>
                <h3 class="h3" style="font-size: 21px; font-weight: 900">{item.product.name}</h3>
                <p class="body" style="font-size: 14px; flex-grow: 1">{item.project.description}</p>
                <span class="more">看介紹</span>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <section data-filter-section class="sec alt">
      <div class="wrap">
        <h2 class="h2" style="font-size: 28px; margin-bottom: 8px">其他專案</h2>
        <p class="body" style="margin-bottom: 24px">沒有獨立介紹頁，還在維護、先停下來和已經收起來的都在這裡。</p>
        {others.map(item => (
          <div class="list-row" data-filter-item data-tags={item.status.group}>
            <span class="status-dot" style={`color: ${item.status.color}`}>● {item.status.label}</span>
            <div><div style="font-size: 17px; font-weight: 700">{item.project.title}</div><div style="margin-top: 8px">{item.project.tech.slice(0, 3).map(tech => <span class="chip-sm">{tech}</span>)}</div></div>
            <span class="body">{item.project.description}</span>
            {item.cta && item.href ? <a class="go" href={item.href}>{item.cta} →</a> : <span></span>}
          </div>
        ))}
      </div>
    </section>
  </div>

  {caseStudies.length > 0 && (
    <section id="cases" class="sec">
      <div class="wrap split">
        <div>
          <h2 class="h2" style="font-size: 28px">客戶專案</h2>
          <p class="sub" style="font-size: 15px">接案做的系統不公開客戶是誰，這裡只寫可以拿去別的專案用的做法。</p>
        </div>
        <div>
          {caseStudies.map(post => (
            <a href={`/blog/${post.slug}`} style="display: block; padding: 18px 0; border-top: 1px solid var(--line)">
              <div class="mono note" style="font-size: 12px">技術案例</div>
              <div style="margin-top: 6px; font-size: 17px; font-weight: 700">{post.title.replace(/^技術案例：/, '')}</div>
              <div class="body" style="margin-top: 6px; font-size: 14px">{post.excerpt}</div>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
  <FilterScript />
</Layout>
