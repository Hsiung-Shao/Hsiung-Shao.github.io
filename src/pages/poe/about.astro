---
import Layout from '../../layouts/Layout.astro';
import { projects } from '../../data/projects';
import poeTools from '../../data/poe-tools.json';

type Intro = {
  problem: string;
  audience: string;
  features: string[];
  support: string[];
  privacy: string;
  limits: string[];
  image: string | null;
};

const tools = poeTools.tools.map(tool => {
  const project = projects.find(candidate => candidate.id === tool.projectId);
  if (!project) throw new Error(`poe-tools.json: 找不到專案 ${tool.projectId}`);
  return { ...tool, project, intro: tool.intro as Intro };
});
---

<Layout title="PoE 工具介紹 | 熊少愆" description="PobTools、Poe Market zh、ExileAppraiser 三個 Path of Exile 繁中工具各自能做什麼、適合誰、支援範圍與限制。">
  <header class="page-intro site-shell">
    <span class="kicker">PoE tools / about</span>
    <h1>三個工具，各補一個缺口。</h1>
    <p>配 BD 用 PobTools，在交易站找東西用 Poe Market zh，遊戲裡查價用 ExileAppraiser。下面寫每個工具能幫你做什麼、支援到哪裡，還有目前做不到的事。下載數和版本紀錄在 <a class="text-link" href="/poe">PoE Tools 數據頁</a>。</p>
    <nav class="about-jump" aria-label="跳到工具">
      {tools.map(tool => <a href={`#${tool.projectId}`}>{tool.project.title}</a>)}
    </nav>
  </header>

  <section class="site-shell pb-20">
    <div class="about-tools">
      {tools.map((tool, index) => (
        <article class="about-tool" id={tool.projectId}>
          <div class="about-head">
            <span class="meta-label text-[var(--quiet)]">{String(index + 1).padStart(2, '0')}</span>
            <h2>{tool.project.title}</h2>
            <p class="about-problem">{tool.intro.problem}</p>
          </div>

          {tool.intro.image && <img class="about-image" src={tool.intro.image} alt={`${tool.project.title} 畫面`} loading="lazy" />}

          <div class="about-grid">
            <section>
              <h3>能做什麼</h3>
              <ul>{tool.intro.features.map(feature => <li>{feature}</li>)}</ul>
            </section>
            <div class="about-side">
              <section>
                <h3>適合誰</h3>
                <p>{tool.intro.audience}</p>
              </section>
              <section>
                <h3>支援範圍</h3>
                <div class="about-tags">{tool.intro.support.map(item => <span class="tag">{item}</span>)}</div>
              </section>
              <section>
                <h3>隱私與安全</h3>
                <p>{tool.intro.privacy}</p>
              </section>
              <section>
                <h3>目前的限制</h3>
                <ul class="about-limits">{tool.intro.limits.map(limit => <li>{limit}</li>)}</ul>
              </section>
            </div>
          </div>

          <div class="about-actions">
            <a class="about-primary" href={tool.primaryUrl} target="_blank" rel="noopener noreferrer">{tool.primaryLabel} ↗</a>
            {tool.project.articles.map(slug => <a class="text-link" href={`/blog/${slug}`}>安裝與使用教學 ↗</a>)}
            <a class="text-link" href={`/poe#${tool.projectId}`}>下載數與版本紀錄 ↗</a>
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>

<style>
  .about-jump { display: flex; flex-wrap: wrap; gap: .5rem; margin-top: 1.4rem; }
  .about-jump a { padding: .4rem .8rem; border: 1px solid var(--line); border-radius: 5px; color: var(--ink); font-size: .8rem; text-decoration: none; }
  .about-jump a:hover { border-color: var(--acid); color: var(--acid); }

  .about-tools { display: grid; gap: 1rem; }
  .about-tool { scroll-margin-top: 100px; display: grid; gap: 1.6rem; padding: 2rem; border-radius: 6px; background: rgb(23 26 23 / 93%); }
  .about-head { display: grid; grid-template-columns: 3rem minmax(0, 1fr); gap: .4rem 1.25rem; align-items: baseline; }
  .about-head h2 { margin: 0; font-size: 1.6rem; }
  .about-problem { grid-column: 2; max-width: 720px; margin: 0; color: var(--muted); font-size: .95rem; line-height: 1.8; }
  .about-image { width: 100%; border-radius: 5px; }

  .about-grid { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: 1rem; }
  .about-grid section { display: grid; gap: .5rem; align-content: start; }
  .about-grid > section, .about-side { padding: 1.2rem 1.3rem; border-radius: 5px; background: #202420; }
  .about-side { display: grid; gap: 1.2rem; align-content: start; }
  .about-grid h3 { margin: 0; color: var(--acid); font-size: .78rem; font-weight: 600; letter-spacing: .04em; }
  .about-grid p { margin: 0; color: var(--ink); font-size: .86rem; line-height: 1.75; }
  .about-grid ul { display: grid; gap: .55rem; margin: 0; padding-left: 1.1rem; color: var(--ink); font-size: .88rem; line-height: 1.7; list-style: square; }
  .about-grid ul.about-limits { color: var(--muted); font-size: .82rem; }
  .about-tags { display: flex; flex-wrap: wrap; gap: .3rem; }

  .about-actions { display: flex; flex-wrap: wrap; gap: .9rem 1.4rem; align-items: center; }
  .about-primary { display: inline-flex; min-height: 40px; padding: .55rem 1rem; align-items: center; border-radius: 5px; background: var(--acid); color: #111; font-size: .8rem; font-weight: 700; text-decoration: none; }
  .about-primary:hover { background: var(--ink); }

  @media (max-width: 760px) {
    .about-tool { padding: 1.3rem; }
    .about-head { grid-template-columns: 2.2rem minmax(0, 1fr); }
    .about-problem { grid-column: 1 / -1; }
    .about-grid { grid-template-columns: 1fr; }
  }
</style>
