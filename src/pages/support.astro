---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import bmcCoffee from '../assets/support/bmc-coffee.webp';
import bmcMembership from '../assets/support/bmc-membership.webp';
import bmcCurrency from '../assets/support/bmc-currency.webp';
import patreonTiers from '../assets/support/patreon-tiers.webp';

// data-ga-* 給 Analytics.astro 記贊助點擊;連結受 validate-content 的內容契約保護,不要改網址
const options = [
  { kind: '單次', title: 'Buy Me a Coffee', description: '請我喝杯咖啡，單次贊助網站維護和工具開發。一杯 1 美元。', href: 'https://buymeacoffee.com/hsiung', action: '到 Buy Me a Coffee 贊助', analyticsId: 'buy_me_a_coffee', analyticsType: 'direct', rel: 'noopener noreferrer', affiliate: false },
  { kind: '每月', title: 'Patreon', description: '每月小額支持，3 美元起，隨時可以在 Patreon 調整或取消。', href: 'https://patreon.com/HsiungShao?utm_medium=unknown&utm_source=join_link&utm_campaign=creatorshare_creator&utm_content=copyLink', action: '到 Patreon 贊助', analyticsId: 'patreon', analyticsType: 'recurring', rel: 'noopener noreferrer', affiliate: false },
  { kind: '聯盟連結 · 我會拿到分潤', title: 'ExitLag', description: '剛好需要跨區連線加速的話，可以用我的推薦連結看方案。你完成註冊或購買後我可能拿到分潤，價格和服務以官方頁面為準。', href: 'https://www.exitlag.com/refer/10318098', action: '看 ExitLag 方案', analyticsId: 'exitlag', analyticsType: 'affiliate', rel: 'sponsored nofollow noopener noreferrer', affiliate: true },
];

// 步驟與截圖都是 2026-11-06 在兩個平台頁面上實際看到的畫面;方案或價格改了要重截。
// ExitLag 是聯盟連結,刻意不給教學
const oneTime = {
  title: 'Buy Me a Coffee 請咖啡',
  image: { src: bmcCoffee, alt: 'Buy Me a Coffee 的贊助欄：選杯數 1、3、5、10，下面是名字、留言、Make this monthly 勾選框和 Support 按鈕' },
  steps: [
    '點「到 Buy Me a Coffee 贊助」，會開啟我的頁面。',
    '在「Buy 宅熊 (HsiungShao) a coffee」選要請幾杯：1、3、5、10，或在最右邊的框自己輸入數量。一杯是 1 美元，按鈕上的「Support $N」會跟著變。',
    '想留話的話，填名字和留言；不填也可以。',
    '「Make this monthly」不要勾，這樣就只扣這一次。',
    '按「Support $N」，接著在跳出的付款畫面完成付款。',
  ],
  note: '只扣一次，不會之後自動續扣。',
};
const monthly = [
  {
    title: 'Buy Me a Coffee 會員',
    image: { src: bmcMembership, alt: 'Buy Me a Coffee 的 Membership 分頁，列出維護支援 $1、支持開發 $3、熊窩夥伴 $5 三個每月方案與 Join 按鈕' },
    steps: [
      '打開我的 Buy Me a Coffee 頁面，切到上方的「Membership」分頁。',
      '從四個方案選一個：維護支援 1 美元、支持開發 3 美元、熊窩夥伴 5 美元、功能贊助 30 美元，都是每月。第四個方案要按右邊的箭頭才看得到。',
      '按方案的「Join」，照畫面登入或註冊，再完成付款。',
      '之後每個月自動扣款；要換方案或取消，登入 Buy Me a Coffee 帳號就能管理。',
    ],
    note: '四個方案都寫著含 Discord 福利。只想固定每月請咖啡、不需要方案的話，也可以在首頁勾「Make this monthly」再按「Support」。',
  },
  {
    title: 'Patreon',
    image: { src: patreonTiers, alt: 'Patreon 的選擇會籍畫面，有支持開發 $3、熊窩夥伴 $5、功能贊助 $20 三個每月方案與加入按鈕' },
    steps: [
      '點「到 Patreon 贊助」，會開啟我的 Patreon 頁面，在「選擇會籍」可以看到所有方案。',
      '從三個方案選一個：支持開發 3 美元、熊窩夥伴 5 美元（包含 3 美元等級的內容）、功能贊助 20 美元，都是每月，按「加入」。',
      '還沒有 Patreon 帳號的話，照畫面註冊或登入。',
      '填好付款方式完成加入，之後每個月自動扣款。',
      '要調整金額或取消，到 Patreon 的會員設定改就好，隨時都可以。',
    ],
    note: '頁面右上角的「免費加入」不會扣款，要贊助請選上面的付費方案。下方的「向宅熊贈送會籍」可以幫別人付會籍。',
  },
];
---

<Layout title="贊助 | 熊少愆" description="工具都免費、開源。想支持網站和工具繼續更新，可以用 Buy Me a Coffee 或 Patreon，金額以美元計。">
  <section class="page-head" style="padding-bottom: 56px">
    <div class="wrap">
      <h1 class="h1">贊助這些工具</h1>
      <p class="lede" style="max-width: 42em">工具都免費、開源，不贊助也照樣能用。如果有幫上忙、想讓它繼續更新，可以用下面的方式支持，錢會拿去付伺服器和網域這些長期的費用。</p>
    </div>
  </section>

  <section style="padding-bottom: 80px">
    <div class="wrap grid g3">
      {options.map(option => (
        <div class:list={['option', { affiliate: option.affiliate }]}>
          <span class="mono" style={`font-size: 12px; font-weight: 600; color: ${option.affiliate ? 'var(--quiet)' : 'var(--accent)'}`}>{option.kind}</span>
          <h2 class="h3" style="font-size: 24px; font-weight: 900">{option.title}</h2>
          <p class="body" style="flex-grow: 1">{option.description}</p>
          <a class:list={['btn', option.affiliate ? 'btn-sub' : 'btn-main']} style="justify-content: center" href={option.href} target="_blank" rel={option.rel} data-ga-event="support_click" data-ga-support-method={option.analyticsId} data-ga-support-type={option.analyticsType}>{option.action}</a>
        </div>
      ))}
    </div>
  </section>

  <section id="how" class="sec alt">
    <div class="wrap">
      <h2 class="h2" style="font-size: 28px">怎麼贊助</h2>
      <p class="sub">分成只贊助一次，和每個月自動贊助兩種。付款都是在平台自己的頁面完成，這個網站不會經手任何付款資料。</p>

      <div class="box currency" style="margin-top: 32px; background: var(--bg)">
        <div>
          <p class="kick" style="margin-bottom: 8px">金額的幣值</p>
          <p class="body">兩個平台上的價格都是<strong style="color: var(--ink)">美元（USD）</strong>，「$1」就是 1 美元，不是新台幣。Buy Me a Coffee 頁面最下面有幣別選單，可以換成其他幣別顯示；實際扣多少、用哪種幣別扣，以付款畫面上寫的為準，信用卡刷外幣可能還會有發卡銀行的海外手續費。</p>
        </div>
        <figure class="shot" style="background: #f5f5f5"><Image src={bmcCurrency} alt="Buy Me a Coffee 頁面底部的語言與幣別選單，顯示 $ USD" widths={[480, 960]} sizes="(max-width: 900px) 100vw, 420px" /></figure>
      </div>

      <div style="margin-top: 64px">
        <p class="kick">單次贊助</p>
        <h3 class="h2" style="font-size: 24px">只贊助一次</h3>
        <p class="sub" style="font-size: 15px; margin-bottom: 28px">用 Buy Me a Coffee，選杯數付款就好，不會續扣。</p>
        <div class="box guide" style="background: var(--bg)">
          <figure class="shot"><Image src={oneTime.image.src} alt={oneTime.image.alt} widths={[480, 1000]} sizes="(max-width: 900px) 100vw, 460px" /></figure>
          <div>
            <h4 class="h3" style="font-size: 20px; font-weight: 900">{oneTime.title}</h4>
            <ol class="list big" style="margin-top: 12px">{oneTime.steps.map(step => <li><span>{step}</span></li>)}</ol>
            <p class="note" style="margin-top: 16px; line-height: 1.8">{oneTime.note}</p>
          </div>
        </div>
      </div>

      <div style="margin-top: 64px">
        <p class="kick">每月訂閱</p>
        <h3 class="h2" style="font-size: 24px">每個月自動贊助</h3>
        <p class="sub" style="font-size: 15px; margin-bottom: 28px">Buy Me a Coffee 和 Patreon 都可以，挑你常用的那個。兩邊的方案和價格不完全一樣，下面分開寫。</p>
        <div style="display: grid; gap: 32px">
          {monthly.map(guide => (
            <div class="box guide" style="background: var(--bg)">
              <figure class="shot"><Image src={guide.image.src} alt={guide.image.alt} widths={[640, 1280, 2000]} sizes="(max-width: 900px) 100vw, 560px" /></figure>
              <div>
                <h4 class="h3" style="font-size: 20px; font-weight: 900">{guide.title}</h4>
                <ol class="list big" style="margin-top: 12px">{guide.steps.map(step => <li><span>{step}</span></li>)}</ol>
                <p class="note" style="margin-top: 16px; line-height: 1.8">{guide.note}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap split">
      <h2 class="h2" style="font-size: 26px">贊助不會換到什麼</h2>
      <p style="margin: 0; font-size: 16px; line-height: 1.9; color: var(--body)">贊助不會影響工具要做什麼功能，也不會影響文章怎麼寫。聯盟連結只會出現在這一頁，而且都會標清楚，不會混在下載連結裡。</p>
    </div>
  </section>
</Layout>

<style>
  .guide { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 36px; align-items: start; }
  .currency { display: grid; grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr); gap: 32px; align-items: center; }
  @media (max-width: 900px) {
    .guide, .currency { grid-template-columns: minmax(0, 1fr); gap: 20px; }
  }
</style>
