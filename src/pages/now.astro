---
import Layout from '../layouts/Layout.astro';
import { now } from '../data/now';
const updatedLabel = now.updated ? new Date(now.updated).toLocaleDateString('zh-TW', { dateStyle: 'long' }) : '尚未更新';
---
<Layout title="現在進行式 | 熊少愆">
  <header class="page-intro site-shell"><span class="kicker">Now / updated {updatedLabel}</span><h1>目前投入時間的地方。</h1><p>這是一張短期工作快照：哪些系統正在推進、目前的焦點是什麼，以及公開內容與客戶工作的邊界。</p></header>
  <section class="site-shell py-20"><div class="now-focus"><span class="meta-label text-[var(--red)]">Current focus</span><p>{now.focus}</p></div><div class="mt-12">{now.projects.map((project, index) => <article class="work-row"><span class="index">0{index + 1}</span><div><h3>{project.name}</h3><span class="meta-label text-[var(--blue)]">{project.tier === 'protected' ? 'Protected technical work' : 'Public project'}</span></div><div class="work-meta"><p>{project.status}</p></div></article>)}</div></section>
</Layout>
