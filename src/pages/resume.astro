---
import Layout from '../layouts/Layout.astro';
import { resume, resumeProjects, otherResumeProjects } from '../data/resume';
---

<Layout title="履歷 | 熊少愆" description="熊少愆（Jerry）的履歷：PHP／ERP 後端開發經歷、客戶專案，以及 Path of Exile 工具、直播與 AI 音樂等個人專案。">
  <div class="cv-page">
    <section class="page-head" style="padding-block: 72px 48px; border-bottom: 1px solid var(--line)">
      <div class="wrap" style="display: flex; justify-content: space-between; align-items: end; flex-wrap: wrap; gap: 24px">
        <div>
          <h1 class="h1" style="font-size: 52px; line-height: 1.15">{resume.name}</h1>
          <p class="mono note" style="margin-top: 10px; font-size: 15px">{resume.nameEn} · {resume.headline} · {resume.location}</p>
        </div>
        <div class="cv-actions" style="display: flex; flex-wrap: wrap; gap: 12px; align-items: center">
          <span class="note">列印時會轉成白底黑字的 A4</span>
          <button type="button" class="btn btn-main" data-resume-print style="border: 0; cursor: pointer; font-family: inherit">列印 / 存成 PDF</button>
        </div>
      </div>
    </section>

    <section style="padding: 56px 0 88px">
      <div class="wrap cv">
        <aside class="cv-side">
          <div class="cv-sec">
            <p class="cv-lbl">聯絡</p>
            <div style="display: flex; flex-direction: column; gap: 10px; font-size: 15px">
              {resume.contact.map(item => <a href={item.href}>{item.value}</a>)}
            </div>
          </div>
          <div class="cv-sec">
            <p class="cv-lbl">技能</p>
            {resume.skills.map(group => <div style="margin-bottom: 16px"><div style="font-size: 14px; font-weight: 700; margin-bottom: 8px">{group.label}</div>{group.items.map(item => <span class="chip-sm">{item}</span>)}</div>)}
          </div>
          <div class="cv-sec">
            <p class="cv-lbl">學歷</p>
            {resume.education.map(item => <div style="margin-bottom: 10px; font-size: 15px; line-height: 1.7"><div style="font-weight: 700">{item.school} {item.department}</div><div class="mono note">{item.period}・{item.degree}</div></div>)}
          </div>
          <div class="cv-sec">
            <p class="cv-lbl">證照</p>
            <div style="font-size: 15px; line-height: 1.9; color: var(--body)">{resume.certifications.map(item => <div>{item}</div>)}</div>
          </div>
        </aside>

        <div>
          <div class="cv-sec">
            <p class="cv-lbl">簡介</p>
            {resume.summary.map(paragraph => <p style="margin: 0 0 14px; font-size: 17px; line-height: 1.9; color: var(--body)">{paragraph}</p>)}
          </div>
          <div class="cv-sec">
            <p class="cv-lbl">工作經歷</p>
            {resume.experience.map((job, index) => (
              <article style={index > 0 ? 'margin-top: 32px' : undefined}>
                <div style="display: flex; justify-content: space-between; flex-wrap: wrap; gap: 8px; align-items: baseline">
                  <h2 style="margin: 0; font-size: 22px; font-weight: 900">{job.company} · {job.role}</h2>
                  <span class="mono note" style="font-size: 14px">{job.period ?? job.industry}</span>
                </div>
                {job.period && <div class="note" style="margin-top: 4px">{job.industry}</div>}
                <p class="body" style="margin-top: 10px">{job.summary}</p>
                <ul style="margin: 8px 0 0; padding: 0">{job.highlights.map(item => <li class="cv-li">{item}</li>)}</ul>
                <div style="margin-top: 12px">{job.tech.map(tech => <span class="chip-sm">{tech}</span>)}</div>
              </article>
            ))}
          </div>
          <div class="cv-sec">
            <p class="cv-lbl">個人專案</p>
            {resumeProjects.map(({ project, note, metric }) => (
              <div class="cv-row">
                <div>
                  <div style="font-size: 16px; font-weight: 700">{project.link ? <a href={project.link} target="_blank" rel="noopener noreferrer">{project.title} ↗</a> : project.title}</div>
                  {metric && <div class="mono" style="margin-top: 4px; font-size: 12px; color: var(--accent)">{metric.label} {metric.value}（{metric.asOf}）</div>}
                </div>
                <div style="font-size: 15px; line-height: 1.8; color: var(--body)">{note}</div>
              </div>
            ))}
            <p class="note" style="margin-top: 16px; font-size: 14px">其他專案：{otherResumeProjects.map(project => project.title).join('、')}。詳細說明在 <a class="more" href="/projects">全部專案</a></p>
          </div>
          <div class="cv-sec">
            <p class="cv-lbl">競賽（高職時期）</p>
            {resume.awards.map(award => <div class="cv-row"><div style="font-size: 15px; font-weight: 700; color: var(--accent)">{award.result}</div><div style="font-size: 15px; line-height: 1.8; color: var(--body)">{award.name}</div></div>)}
          </div>
        </div>
      </div>
    </section>
  </div>
</Layout>

<script>
  function setupResumePrint() {
    const button = document.querySelector<HTMLButtonElement>('[data-resume-print]');
    if (!button || button.dataset.bound === 'true') return;
    button.dataset.bound = 'true';
    button.addEventListener('click', () => window.print());
  }
  document.addEventListener('astro:page-load', setupResumePrint);
  setupResumePrint();
</script>
