---
import Layout from '../layouts/Layout.astro';
import { posts } from '../data/posts';
import { projects } from '../data/projects';

const activeWork = projects.filter(project => project.status === 'active').slice(0, 3);
const latestPosts = posts.filter(post => !post.draft).sort((a, b) => b.date.localeCompare(a.date)).slice(0, 4);
const typeLabels = { engineering: '開發筆記', 'case-study': '技術案例', retrospective: '回顧', guide: '使用指南' };
---

<Layout title="熊少愆 | 獨立軟體開發與技術系統" description="熊少愆的個人網站：全端系統、本地工具、遊戲資料與可驗證的繁體中文化工程。">
  <section class="home-hero" aria-labelledby="hero-title">
    <div class="hero-shade"></div>
    <div class="site-shell hero-copy">
      <div class="hero-telemetry"><span>HSIUNG-SHAO</span><span>TAIWAN</span><span>SELECTED WORK / 2026</span></div>
      <div class="hero-primary">
        <p class="spatial-eyebrow">INDEPENDENT SOFTWARE PRACTICE</p>
        <h1 id="hero-title"><span>熊</span><span>少</span><span>愆</span></h1>
        <p class="lead">全端工程師，也是長期維護工具的人。從資料模型、桌面程式到遊戲在地化，我在意的不只是功能能跑，而是資料可信、邊界清楚，下一次改版仍然能繼續走下去。</p>
        <div class="hero-actions">
          <a href="/projects" class="command-link">瀏覽專案 <span>↗</span></a>
          <a href="/blog" class="command-link secondary">閱讀文章 <span>↗</span></a>
        </div>
      </div>
      <div class="hero-foot" aria-label="工作重點">
        <div><small>使用技術</small><strong>React · TypeScript · C++ · Python</strong></div>
        <div><small>目前關注</small><strong>控制面板 · 開發工作台 · PoE 工具</strong></div>
        <div><small>工作原則</small><strong>Local-first · Verifiable · Maintainable</strong></div>
      </div>
    </div>
  </section>

  <section class="site-shell spatial-section mission-section">
    <header class="spatial-section-head"><div><span>CURRENT WORK</span><h2>目前持續投入的專案</h2></div><p>真正持續投入、會產生下一個版本的工作。</p></header>
    <div class="mission-list">
      {activeWork.map((project, index) => (
        <article class="mission-item">
          <div class="mission-index">0{index + 1}</div>
          <div class="mission-state"><span></span>持續開發</div>
          <div class="mission-copy"><h3>{project.title}</h3><p>{project.description}</p></div>
          <p class="mission-detail">{project.highlights[0]}</p>
        </article>
      ))}
    </div>
    <a class="spatial-text-link" href="/now">查看完整近況 <span>↗</span></a>
  </section>

  <section class="spatial-band featured-system">
    <div class="site-shell">
      <header class="spatial-section-head"><div><span>SELECTED PROJECT</span><h2>多直播空間控制介面</h2></div><p>MultiStream Hub 把播放器、聊天室、收藏與響應式布局收進同一塊畫布。</p></header>
      <div class="media-feature">
        <figure><img src="/images/guides/multistream/multistream-live-grid.png" alt="MultiStream Hub 同時觀看三個直播與聊天室的畫面" loading="lazy" /></figure>
        <div class="copy">
          <span class="spatial-eyebrow">React · Cloudflare · Supabase</span>
          <h3>MultiStream<br />Hub</h3>
          <p>從多 iframe 的生命週期、手機橫向操作，到 Twitch 與 YouTube 的平台限制，這是一個持續在真實瀏覽器環境裡修正的產品。</p>
          <div class="feature-actions"><a href="/blog/multistream-hub-guide">閱讀指南 ↗</a><a href="https://multistreaming.org" target="_blank" rel="noopener noreferrer">開啟網站 ↗</a></div>
        </div>
      </div>
    </div>
  </section>

  <section class="site-shell spatial-section principle-section">
    <header class="spatial-section-head"><div><span>WORKING PRINCIPLES</span><h2>我如何做出工程決策</h2></div><p>從錯誤紀錄與專案決策中形成的工作原則。</p></header>
    <div class="principle-grid">
      <article><span>01</span><small>EVIDENCE</small><h3>先確認，再敘述</h3><p>文件、版本、資料來源與實際操作都要能交叉核對，尤其是公開指南與遊戲資料。</p></article>
      <article><span>02</span><small>BOUNDARIES</small><h3>保護不該公開的部分</h3><p>客戶案例只談可重用的工程方法；設定、憑證與營運細節不拿來填充作品集。</p></article>
      <article><span>03</span><small>CONTINUITY</small><h3>讓上游繼續更新</h3><p>能以低侵入方式共存，就不複製整套系統。PobTools 的零污染策略正是這種選擇。</p></article>
      <article><span>04</span><small>RECORD</small><h3>把錯誤變成資產</h3><p>記錄症狀、根因、修法與預防方式，減少下一次用相同代價學習。</p></article>
    </div>
  </section>

  <section class="spatial-band writing-feed">
    <div class="site-shell">
      <header class="spatial-section-head"><div><span>RECENT WRITING</span><h2>最近整理的文章</h2></div><a href="/blog">查看全部文章 ↗</a></header>
      <div class="post-index">
        {latestPosts.map((post, index) => (
          <article><a class="post-row" href={`/blog/${post.slug}`}>
            <div class="post-code">W-{String(index + 1).padStart(2, '0')}<time>{post.date}</time></div>
            <div><small>{post.type ? typeLabels[post.type] : '文章'}</small><h2>{post.title}</h2><p>{post.excerpt}</p></div>
            <div class="post-tags">{post.tags.slice(0, 4).map(tag => <span class="tag">{tag}</span>)}</div>
            <span class="post-arrow">↗</span>
          </a></article>
        ))}
      </div>
    </div>
  </section>
</Layout>
