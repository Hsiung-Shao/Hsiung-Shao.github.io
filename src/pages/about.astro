---
import Layout from '../layouts/Layout.astro';
import { resume } from '../data/resume';
import { products } from '../data/products';

const notes: Record<string, string> = {
  pobtools: 'POB 繁中化啟動器',
  'poe-market-zh': '交易站中文化擴充',
  'exile-appraiser': '遊戲內查價',
  'multistream-hub': '多直播同時觀看',
  'kumori-music': 'AI 原創動畫風歌曲',
};
// 關於頁的技能只取每組前六項,完整的在履歷
const skills = resume.skills.map(group => ({ ...group, items: group.items.slice(0, 6) }));
const job = resume.experience[0];
---

<Layout title="關於熊少愆" description="熊少愆是後端工程師，白天一個人維護公司 ERP，下班做 Path of Exile 繁中工具、直播觀看網站和 AI 音樂。">
  <section class="page-head" style="padding-block: 88px 80px">
    <div class="wrap split" style="align-items: end">
      <div>
        <p class="kick">{resume.name} · Jerry · {resume.location}</p>
        <h1 class="h1" style="font-size: 52px; line-height: 1.2">{'我是後端工程師，\n下班做遊戲工具'}</h1>
      </div>
      <div>
        <p style="margin: 0; font-size: 18px; line-height: 1.9; color: var(--body)">白天我一個人負責公司內部的 ERP，從資料庫 schema、後端程式到前端畫面和第三方 API 串接都是我寫的，已經穩定跑了兩年多。</p>
        <p style="margin: 16px 0 0; font-size: 18px; line-height: 1.9; color: var(--body)">下班做自己會用到的東西：Path of Exile 的繁中化和查價工具、多平台直播觀看網站，還有 AI 音樂。</p>
        <div class="btns" style="margin-top: 28px"><a class="btn btn-main" href="/resume">看履歷</a><a class="btn btn-sub" href="/contact">聯絡我</a></div>
      </div>
    </div>
  </section>

  <section class="sec alt">
    <div class="wrap split">
      <h2 class="h2" style="font-size: 32px">我花最多時間的地方</h2>
      <div>
        <p style="margin: 0; font-size: 17px; line-height: 1.9; color: var(--body)">我做的工具大多依附在別人的產品上。遊戲會改版，網站會換結構，執行環境也可能根本不存在，所以我花在相容性、資料驗證和長期維護的時間，常常比寫新功能還多。</p>
        <p style="margin: 16px 0 0; font-size: 17px; line-height: 1.9; color: var(--body)">像 PobTools 的翻譯是從官方遊戲客戶端整理的，Poe Market zh 的譯名是依官方 id 對上去的，對不上的就保留英文，不亂猜。</p>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap">
      <h2 class="h2" style="font-size: 32px; margin-bottom: 32px">平常在用的技術</h2>
      <div class="grid auto">
        {skills.map(group => <div class="box"><p class="cv-lbl">{group.label}</p><div>{group.items.map(item => <span class="chip-sm" style="font-size: 13px; color: var(--body)">{item}</span>)}</div></div>)}
      </div>
    </div>
  </section>

  <section class="sec alt">
    <div class="wrap split">
      <div>
        <h2 class="h2" style="font-size: 32px">經歷</h2>
        <a class="more" href="/resume" style="display: inline-block; margin-top: 16px">完整履歷，可列印</a>
      </div>
      <div>
        <div class="cv-row" style="grid-template-columns: 130px minmax(0, 1fr); border-top: 0">
          <span class="mono note" style="font-size: 14px">{job.period}</span>
          <div><div style="font-size: 18px; font-weight: 700">{job.role} · {job.industry}</div><p class="body" style="margin-top: 8px">一個人負責內部 ERP：客戶、訂單、採購、庫存、批號效期和報表，還有電子發票與電商訂單整合。</p></div>
        </div>
        <div class="cv-row" style="grid-template-columns: 130px minmax(0, 1fr)">
          <span class="mono note" style="font-size: 14px">接案</span>
          <div><div style="font-size: 18px; font-weight: 700">全端工程師 · 客戶名稱不公開</div><p class="body" style="margin-top: 8px">資料管理平台和品牌網站。可以公開的做法寫在<a class="more" href="/projects#cases" style="margin-left: 4px">技術案例</a></p></div>
        </div>
      </div>
    </div>
  </section>

  <section class="sec">
    <div class="wrap split">
      <div>
        <h2 class="h2" style="font-size: 32px">下班做的東西</h2>
        <p class="sub" style="font-size: 15px">很多都是玩遊戲時覺得不方便，就自己做一個。</p>
      </div>
      <div>
        {products.map(product => (
          <a href={`/projects/${product.slug}`} style="display: flex; justify-content: space-between; gap: 16px; padding: 16px 0; border-top: 1px solid var(--line); font-size: 16px">
            <span style="font-weight: 700">{product.name}</span><span class="body" style="text-align: right">{notes[product.slug] ?? ''} →</span>
          </a>
        ))}
      </div>
    </div>
  </section>

  <section class="sec sunk">
    <div class="wrap split" style="align-items: center">
      <h2 class="h2" style="font-size: 28px">工作以外</h2>
      <p style="margin: 0; font-size: 17px; line-height: 1.9; color: var(--body)">平常玩 Path of Exile、Minecraft、Valorant，也看動畫，Kumori Music 的歌多半是以動畫作品為靈感寫的。</p>
    </div>
  </section>
</Layout>
