---
import Layout from '../layouts/Layout.astro';
import { activity } from '../data/activity';

const sorted = [...activity].sort((a, b) => b.date.localeCompare(a.date));

const grouped = new Map<string, typeof sorted>();
for (const entry of sorted) {
  const month = entry.date.slice(0, 7);
  if (!grouped.has(month)) grouped.set(month, []);
  grouped.get(month)!.push(entry);
}
---

<Layout title="活動日誌 | 熊少愆">
  <section class="max-w-3xl mx-auto px-6 py-16">
    <header class="mb-10">
      <h1 class="text-4xl font-bold mb-2">Activity</h1>
      <p class="text-sm text-[var(--color-text-secondary)]">跨專案的每日開發紀要,由自動化腳本彙整。</p>
    </header>

    {sorted.length === 0 ? (
      <p class="text-[var(--color-text-secondary)]">尚未有活動紀錄。首次自動腳本執行後會出現在這裡。</p>
    ) : (
      <div class="space-y-10">
        {Array.from(grouped.entries()).map(([month, entries]) => (
          <div>
            <h2 class="text-lg font-semibold mb-4 text-[var(--color-accent-cyan)]">{month}</h2>
            <ul class="space-y-4">
              {entries.map(e => (
                <li class="rounded-lg border border-[var(--color-card-border)] bg-[var(--color-card-bg)] p-4">
                  <div class="flex items-center gap-2 mb-2 text-xs text-[var(--color-text-secondary)]">
                    <time>{e.date}</time>
                    <span>·</span>
                    <span class="font-medium text-[var(--color-text-primary)]">{e.project}</span>
                    <span class:list={[
                      'px-2 py-0.5 rounded-full',
                      e.tier === 'protected'
                        ? 'bg-amber-500/10 text-amber-400 border border-amber-500/30'
                        : 'bg-cyan-500/10 text-cyan-400 border border-cyan-500/30'
                    ]}>{e.tier === 'protected' ? '客戶' : '個人'}</span>
                  </div>
                  <p class="text-sm leading-relaxed">{e.summary}</p>
                  {e.tags && e.tags.length > 0 && (
                    <div class="mt-2 flex flex-wrap gap-1">
                      {e.tags.map(t => <span class="text-xs px-2 py-0.5 rounded bg-[var(--color-bg-primary)] text-[var(--color-text-secondary)]">#{t}</span>)}
                    </div>
                  )}
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
    )}
  </section>
</Layout>
