<div class="spatial-scene" data-spatial-scene transition:persist="spatial-scene" aria-hidden="true">
  <canvas></canvas>
</div>

<script>
  let disposeSpatialScene = () => {};
  let updateSpatialMode = () => {};

  async function setupSpatialScene() {
    const root = document.querySelector<HTMLElement>('[data-spatial-scene]');
    const canvas = root?.querySelector<HTMLCanvasElement>('canvas');
    if (!root || !canvas || root.dataset.initialized === 'true') {
      updateSpatialMode();
      return;
    }

    root.dataset.initialized = 'true';
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const abortController = new AbortController();
    const { signal } = abortController;
    let animationFrame = 0;
    let disposed = false;
    let running = !document.hidden;

    try {
      const THREE = await import('three');
      if (!root.isConnected) return;

      const renderer = new THREE.WebGLRenderer({ canvas, antialias: true, powerPreference: 'high-performance' });
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));
      renderer.outputColorSpace = THREE.SRGBColorSpace;
      renderer.toneMapping = THREE.ACESFilmicToneMapping;
      renderer.toneMappingExposure = 0.9;

      const scene = new THREE.Scene();
      scene.background = new THREE.Color(0x090a09);
      scene.fog = new THREE.Fog(0x090a09, 9, 31);

      const camera = new THREE.PerspectiveCamera(44, 1, 0.1, 70);
      camera.position.set(0, 0.7, 10.5);
      camera.lookAt(0, 0, -5);

      const world = new THREE.Group();
      const atmosphereLayer = new THREE.Group();
      const routeLayer = new THREE.Group();
      scene.add(world);
      world.add(atmosphereLayer, routeLayer);

      scene.add(new THREE.HemisphereLight(0xf5f0df, 0x111511, 2.1));
      const keyLight = new THREE.DirectionalLight(0xe8ff9f, 3.3);
      keyLight.position.set(-6, 8, 9);
      scene.add(keyLight);
      const fillLight = new THREE.PointLight(0xff765f, 35, 30, 2);
      fillLight.position.set(8, -2, 4);
      scene.add(fillLight);

      const permanentResources: Array<{ dispose: () => void }> = [];
      let routeResources: Array<{ dispose: () => void }> = [];
      let routeObjects: Array<{
        position: { x: number; y: number; z: number };
        rotation: { x: number; y: number; z: number };
        userData: { baseY?: number };
      }> = [];

      const atmosphereBlocks: Array<{
        position: { x: number; y: number; z: number };
        rotation: { x: number; y: number; z: number };
        userData: { baseY?: number };
      }> = [];

      const atmosphereLayout: Array<{
        size: [number, number, number];
        position: [number, number, number];
        rotation: [number, number, number];
        color: number;
      }> = [
        { size: [8.5, 5.8, 0.8], position: [-6.7, 2.2, -8], rotation: [0.08, 0.28, -0.06], color: 0x1b221c },
        { size: [6.2, 8.4, 1.1], position: [7.2, -0.8, -11], rotation: [-0.1, -0.34, 0.1], color: 0x242b20 },
        { size: [10.5, 2.1, 0.7], position: [0.6, -5.2, -9], rotation: [0.18, -0.12, -0.05], color: 0x30221f },
        { size: [3.8, 7.2, 1.4], position: [1.4, 4.8, -16], rotation: [-0.12, 0.45, 0.2], color: 0x26302a },
        { size: [5.8, 3.8, 0.9], position: [-8.5, -3.7, -15], rotation: [0.2, -0.4, -0.12], color: 0x343a24 },
      ];

      atmosphereLayout.forEach(item => {
        const geometry = new THREE.BoxGeometry(...item.size);
        const material = new THREE.MeshStandardMaterial({
          color: item.color,
          roughness: 0.84,
          metalness: 0.04,
          transparent: true,
          opacity: 0.72,
        });
        const block = new THREE.Mesh(geometry, material);
        block.position.set(...item.position);
        block.rotation.set(...item.rotation);
        block.userData.baseY = item.position[1];
        atmosphereLayer.add(block);
        atmosphereBlocks.push(block);
        permanentResources.push(geometry, material);
      });

      const clearRouteLayer = () => {
        while (routeLayer.children.length) routeLayer.remove(routeLayer.children[0]);
        routeResources.forEach(resource => resource.dispose());
        routeResources = [];
        routeObjects = [];
      };

      const addBlock = (
        size: [number, number, number],
        color: number,
        position: [number, number, number],
        opacity = 0.82,
      ) => {
        const geometry = new THREE.BoxGeometry(...size);
        const material = new THREE.MeshStandardMaterial({
          color,
          roughness: 0.72,
          metalness: 0.08,
          transparent: opacity < 1,
          opacity,
        });
        const object = new THREE.Mesh(geometry, material);
        object.position.set(...position);
        object.userData.baseY = position[1];
        routeLayer.add(object);
        routeResources.push(geometry, material);
        routeObjects.push(object);
        return object;
      };

      const buildHome = () => {
        const mobile = window.innerWidth < 760;
        const loader = new THREE.TextureLoader();
        const assets = [
          '/images/guides/pobtools/pobtools-pob-main.png',
          '/images/guides/multistream/multistream-live-grid.png',
          '/images/guides/minecraft/00-app-overview.png',
        ];

        assets.forEach((source, index) => {
          const width = mobile ? 6.4 : 5.4;
          const height = mobile ? 3.2 : 2.7;
          const x = mobile ? 0.8 : 3.45 + index * 0.48;
          const y = mobile ? 1.1 - index * 1.5 : 2.05 - index * 2.2;
          const z = -1.8 - index * 1.6;
          const backing = addBlock([width + 0.24, height + 0.24, 0.3], index === 1 ? 0x343b20 : 0x17241f, [x, y, z - 0.22], mobile ? 0.42 : 0.92);
          backing.rotation.y = mobile ? -0.08 : -0.24;

          const texture = loader.load(source);
          texture.colorSpace = THREE.SRGBColorSpace;
          const geometry = new THREE.PlaneGeometry(width, height);
          const material = new THREE.MeshBasicMaterial({ map: texture, transparent: true, opacity: mobile ? 0.12 : 0.72 });
          const plane = new THREE.Mesh(geometry, material);
          plane.position.set(x, y, z);
          plane.rotation.y = mobile ? -0.08 : -0.24;
          plane.userData.baseY = y;
          routeLayer.add(plane);
          routeResources.push(texture, geometry, material);
          routeObjects.push(plane);
        });
      };

      const buildProjects = () => {
        const colors = [0x2e382a, 0x19302a, 0x392923, 0x242b25];
        for (let index = 0; index < 12; index += 1) {
          const column = index % 4;
          const row = Math.floor(index / 4);
          const object = addBlock([1.95, 0.9, 0.5], colors[index % colors.length], [column * 2.35 - 3.55, 1.75 - row * 1.72, -2.2 - row * 1.1], 0.92);
          object.rotation.set(-0.06, column * 0.035 - 0.06, (column - 1.5) * 0.012);
        }
      };

      const buildWriting = () => {
        const colors = [0x28302a, 0x352c25, 0x25342f];
        for (let index = 0; index < 9; index += 1) {
          const object = addBlock([2.75, 3.8, 0.22], colors[index % colors.length], [index * 1.02 - 4.1, (index % 2) * 0.55 - 0.3, -2.8 - index * 0.72], 0.86);
          object.rotation.y = -0.32 + index * 0.07;
          object.rotation.z = (index % 3 - 1) * 0.025;
        }
      };

      const buildActivity = () => {
        addBlock([0.28, 12, 0.34], 0x343b20, [0, -1.2, -7], 0.82);
        for (let index = 0; index < 15; index += 1) {
          const object = addBlock(
            [0.52 + (index % 3) * 0.1, 0.36, 0.52],
            index % 4 === 0 ? 0x793b2f : 0x245044,
            [Math.sin(index * 1.4) * 1.25, 4.35 - index * 0.76, -4.1 - index * 0.28],
            0.94,
          );
          object.rotation.y = index * 0.18;
        }
      };

      const buildProfile = () => {
        const colors = [0x303927, 0x1d332d, 0x3b2823, 0x252c27, 0x343a24];
        for (let index = 0; index < 5; index += 1) {
          const object = addBlock([4.4 - index * 0.32, 5.6 - index * 0.25, 0.38], colors[index], [2.35 + index * 0.24, 0.1 - index * 0.12, -2.5 - index * 1.15], 0.88);
          object.rotation.set(-0.04, -0.22 + index * 0.08, -0.12 + index * 0.055);
        }
      };

      const buildUtility = () => {
        const colors = [0x26352f, 0x3b2c25, 0x303726];
        for (let index = 0; index < 7; index += 1) {
          const object = addBlock([1.6 + (index % 2) * 0.7, 1.35, 0.65], colors[index % colors.length], [(index % 4) * 2.1 - 3.2, Math.floor(index / 4) * -2.2 + 1.2, -3.3 - index * 0.72], 0.82);
          object.rotation.y = (index % 4 - 1.5) * 0.08;
        }
      };

      updateSpatialMode = () => {
        if (disposed) return;
        clearRouteLayer();
        const path = window.location.pathname;
        root.dataset.mode = path === '/' ? 'home' : path.split('/').filter(Boolean)[0] ?? 'home';
        routeLayer.scale.setScalar(0.86);
        routeLayer.rotation.set(0.035, -0.1, 0);
        if (path === '/') buildHome();
        else if (path === '/projects') buildProjects();
        else if (path.startsWith('/blog')) buildWriting();
        else if (path === '/activity') buildActivity();
        else if (path === '/about') buildProfile();
        else buildUtility();
      };

      const pointerTarget = new THREE.Vector2();
      const pointer = new THREE.Vector2();
      const routeScaleTarget = new THREE.Vector3(1, 1, 1);
      let scrollProgress = 0;
      let previousTime = performance.now();

      const resize = () => {
        renderer.setSize(window.innerWidth, window.innerHeight, false);
        camera.aspect = window.innerWidth / window.innerHeight;
        camera.updateProjectionMatrix();
      };

      const handlePointer = (event: PointerEvent) => {
        pointerTarget.set((event.clientX / window.innerWidth) * 2 - 1, -((event.clientY / window.innerHeight) * 2 - 1));
      };

      const handleScroll = () => {
        const range = Math.max(document.documentElement.scrollHeight - window.innerHeight, 1);
        scrollProgress = Math.min(window.scrollY / range, 1);
      };

      const render = (time: number) => {
        if (disposed || !running) return;
        const delta = Math.min((time - previousTime) / 1000, 0.05);
        previousTime = time;
        pointer.lerp(pointerTarget, 0.035);

        world.rotation.y += (pointer.x * 0.055 - world.rotation.y) * 0.02;
        world.rotation.x += (-pointer.y * 0.025 - world.rotation.x) * 0.02;
        camera.position.x += (pointer.x * 0.25 - camera.position.x) * 0.02;
        camera.position.y += (0.7 - scrollProgress * 1.2 - camera.position.y) * 0.02;
        routeLayer.scale.lerp(routeScaleTarget, 0.035);
        routeLayer.rotation.y += (-0.015 - routeLayer.rotation.y) * 0.02;
        routeLayer.rotation.x += (scrollProgress * 0.08 - routeLayer.rotation.x) * 0.02;

        if (!reduceMotion) {
          atmosphereBlocks.forEach((block, index) => {
            block.rotation.y += delta * (index % 2 === 0 ? 0.009 : -0.007);
            block.position.y = (block.userData.baseY ?? 0) + Math.sin(time * 0.00022 + index * 1.7) * 0.18;
          });
          routeObjects.forEach((object, index) => {
            object.position.y = (object.userData.baseY ?? object.position.y) + Math.sin(time * 0.0003 + index * 1.35) * 0.025;
          });
        }

        renderer.render(scene, camera);
        if (!reduceMotion) animationFrame = requestAnimationFrame(render);
      };

      const handleVisibility = () => {
        running = !document.hidden;
        if (running && !reduceMotion && !animationFrame) {
          previousTime = performance.now();
          animationFrame = requestAnimationFrame(render);
        } else if (!running && animationFrame) {
          cancelAnimationFrame(animationFrame);
          animationFrame = 0;
        }
      };

      window.addEventListener('resize', resize, { passive: true, signal });
      window.addEventListener('pointermove', handlePointer, { passive: true, signal });
      window.addEventListener('scroll', handleScroll, { passive: true, signal });
      document.addEventListener('visibilitychange', handleVisibility, { signal });
      document.addEventListener('astro:page-load', updateSpatialMode, { signal });

      resize();
      handleScroll();
      updateSpatialMode();
      render(performance.now());
      root.classList.add('is-ready');

      disposeSpatialScene = () => {
        disposed = true;
        abortController.abort();
        if (animationFrame) cancelAnimationFrame(animationFrame);
        clearRouteLayer();
        permanentResources.forEach(resource => resource.dispose());
        renderer.dispose();
      };
      window.addEventListener('pagehide', disposeSpatialScene, { once: true });
    } catch {
      root.classList.add('is-unavailable');
      abortController.abort();
    }
  }

  document.addEventListener('astro:page-load', setupSpatialScene);
  setupSpatialScene();
</script>
