<div class="motion-progress" aria-hidden="true"><span></span></div>
<div class="page-wipe" aria-hidden="true"><span></span><span></span><span></span></div>

<script>
  let cleanupMotion = () => {};

  function setupMotion() {
    cleanupMotion();

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const abortController = new AbortController();
    const { signal } = abortController;
    const cleanupTasks: Array<() => void> = [];

    document.documentElement.classList.add('motion-enabled');
    document.documentElement.classList.remove('motion-entered');
    requestAnimationFrame(() => requestAnimationFrame(() => document.documentElement.classList.add('motion-entered')));

    const revealSelector = [
      '.page-intro > *',
      '.section-heading > *',
      '.work-row',
      '.media-feature',
      '.principle-grid > *',
      '.mission-item',
      '.spatial-section-head > *',
      '.project-index article',
      '.guide-lead',
      '.post-row',
      '.article-head .content-shell > *',
      '.article-body > *',
      '.activity-month',
      '.activity-month article',
      '.profile-grid > *',
      '.capability-table > div',
      '.support-list article',
      '.contact-list > *',
      '.now-focus',
    ].join(',');

    const revealTargets = Array.from(document.querySelectorAll<HTMLElement>(revealSelector));
    revealTargets.forEach((element, index) => {
      element.classList.add('motion-reveal');
      element.style.setProperty('--motion-delay', `${Math.min(index % 5, 4) * 55}ms`);
    });

    if (reduceMotion) {
      revealTargets.forEach(element => element.classList.add('is-visible'));
    } else {
      const observer = new IntersectionObserver(entries => {
        entries.forEach(entry => {
          if (!entry.isIntersecting) return;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        });
      }, { rootMargin: '0px 0px -9% 0px', threshold: 0.08 });
      revealTargets.forEach(element => observer.observe(element));
      cleanupTasks.push(() => observer.disconnect());
    }

    const progressBar = document.querySelector<HTMLElement>('.motion-progress span');
    const hero = document.querySelector<HTMLElement>('.home-hero');
    let frame = 0;

    const updateScrollEffects = () => {
      frame = 0;
      const scrollRange = document.documentElement.scrollHeight - window.innerHeight;
      const progress = scrollRange > 0 ? Math.min(window.scrollY / scrollRange, 1) : 0;
      progressBar?.style.setProperty('transform', `scaleX(${progress})`);

      if (hero && !reduceMotion) {
        const heroProgress = Math.min(window.scrollY / Math.max(hero.offsetHeight, 1), 1);
        hero.style.setProperty('--hero-scroll', heroProgress.toFixed(3));
      }
    };

    const requestScrollUpdate = () => {
      if (!frame) frame = requestAnimationFrame(updateScrollEffects);
    };

    updateScrollEffects();
    window.addEventListener('scroll', requestScrollUpdate, { passive: true, signal });
    window.addEventListener('resize', requestScrollUpdate, { passive: true, signal });

    if (!reduceMotion && window.matchMedia('(pointer: fine)').matches) {
      document.querySelectorAll<HTMLElement>('.media-feature figure, .guide-lead figure').forEach(surface => {
        const move = (event: PointerEvent) => {
          const rect = surface.getBoundingClientRect();
          const x = (event.clientX - rect.left) / rect.width - 0.5;
          const y = (event.clientY - rect.top) / rect.height - 0.5;
          surface.style.setProperty('--tilt-x', `${(-y * 2.4).toFixed(2)}deg`);
          surface.style.setProperty('--tilt-y', `${(x * 2.4).toFixed(2)}deg`);
          surface.classList.add('is-tilting');
        };
        const leave = () => surface.classList.remove('is-tilting');
        surface.addEventListener('pointermove', move, { signal });
        surface.addEventListener('pointerleave', leave, { signal });
      });
    }

    document.querySelectorAll<HTMLDetailsElement>('.project-index details').forEach(details => {
      const summary = details.querySelector<HTMLElement>('summary');
      const content = details.querySelector<HTMLElement>('.project-detail');
      if (!summary || !content || reduceMotion) return;

      summary.addEventListener('click', event => {
        event.preventDefault();
        if (details.open) {
          const animation = content.animate(
            [{ opacity: 1, transform: 'translateY(0)' }, { opacity: 0, transform: 'translateY(-12px)' }],
            { duration: 180, easing: 'ease-in' },
          );
          animation.addEventListener('finish', () => { details.open = false; }, { once: true });
        } else {
          details.open = true;
          content.animate(
            [{ opacity: 0, transform: 'translateY(-16px)' }, { opacity: 1, transform: 'translateY(0)' }],
            { duration: 360, easing: 'cubic-bezier(.2,.8,.2,1)' },
          );
        }
      }, { signal });
    });

    cleanupMotion = () => {
      abortController.abort();
      cleanupTasks.forEach(task => task());
      if (frame) cancelAnimationFrame(frame);
    };
  }

  document.addEventListener('astro:page-load', setupMotion);
  setupMotion();
</script>
