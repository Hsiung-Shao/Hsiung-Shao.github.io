<div class="three-hero" data-three-hero aria-hidden="true">
  <canvas></canvas>
  <div class="three-hero-axis axis-x"></div>
  <div class="three-hero-axis axis-y"></div>
</div>

<script>
  let disposeThreeHero = () => {};

  async function setupThreeHero() {
    disposeThreeHero();

    const root = document.querySelector<HTMLElement>('[data-three-hero]');
    const canvas = root?.querySelector<HTMLCanvasElement>('canvas');
    if (!root || !canvas) return;

    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const abortController = new AbortController();
    const { signal } = abortController;
    let animationFrame = 0;
    let running = true;
    let disposed = false;

    try {
      const THREE = await import('three');
      if (!root.isConnected || disposed) return;

      const renderer = new THREE.WebGLRenderer({
        canvas,
        alpha: true,
        antialias: true,
        powerPreference: 'high-performance',
      });
      renderer.setClearColor(0x000000, 0);
      renderer.setPixelRatio(Math.min(window.devicePixelRatio, 1.5));

      const scene = new THREE.Scene();
      const camera = new THREE.PerspectiveCamera(48, 1, 0.1, 40);
      camera.position.set(0, 0, 6);

      const field = new THREE.Group();
      field.rotation.z = -0.035;
      scene.add(field);

      const geometries: Array<{ dispose: () => void }> = [];
      const materials: Array<{ dispose: () => void }> = [];
      const frames: Array<{ position: { z: number }; rotation: { z: number }; userData: Record<string, unknown> }> = [];
      const frameColors = [0x82a3ff, 0x54c9a3, 0xff7a66];
      const frameCount = window.innerWidth < 700 ? 7 : 11;

      for (let index = 0; index < frameCount; index += 1) {
        const width = 7.2 + index * 0.28;
        const height = 4.2 + index * 0.18;
        const box = new THREE.BoxGeometry(width, height, 0.035);
        const edges = new THREE.EdgesGeometry(box);
        const material = new THREE.LineBasicMaterial({
          color: frameColors[index % frameColors.length],
          transparent: true,
          opacity: index % 3 === 0 ? 0.36 : 0.19,
        });
        const frame = new THREE.LineSegments(edges, material);
        frame.position.z = 1.4 - index * 1.35;
        frame.rotation.z = (index % 2 === 0 ? 1 : -1) * 0.012 * index;
        frame.userData.offset = index * 1.35;
        field.add(frame);
        frames.push(frame);
        geometries.push(box, edges);
        materials.push(material);
      }

      const traceColors = [0x82a3ff, 0xff7a66, 0x54c9a3];
      traceColors.forEach((color, traceIndex) => {
        const points = [];
        for (let step = 0; step < 18; step += 1) {
          const depth = 1.5 - step * 0.85;
          const phase = step * 0.72 + traceIndex * 1.7;
          points.push(new THREE.Vector3(
            Math.sin(phase) * (2.5 + traceIndex * 0.4),
            Math.cos(phase * 0.72) * (1.4 + traceIndex * 0.18),
            depth,
          ));
        }
        const geometry = new THREE.BufferGeometry().setFromPoints(points);
        const material = new THREE.LineBasicMaterial({ color, transparent: true, opacity: 0.55 });
        const trace = new THREE.Line(geometry, material);
        field.add(trace);
        geometries.push(geometry);
        materials.push(material);
      });

      const pointer = new THREE.Vector2();
      const pointerTarget = new THREE.Vector2();
      let scrollTarget = 0;
      let previousTime = performance.now();

      const resize = () => {
        const { width, height } = root.getBoundingClientRect();
        if (width <= 0 || height <= 0) return;
        renderer.setSize(width, height, false);
        camera.aspect = width / height;
        camera.updateProjectionMatrix();
      };

      const updatePointer = (event: PointerEvent) => {
        pointerTarget.set(
          (event.clientX / window.innerWidth) * 2 - 1,
          -((event.clientY / window.innerHeight) * 2 - 1),
        );
      };

      const updateScroll = () => {
        scrollTarget = Math.min(window.scrollY / Math.max(root.offsetHeight, 1), 1);
      };

      const render = (time: number) => {
        if (disposed || !running) return;
        const delta = Math.min((time - previousTime) / 1000, 0.05);
        previousTime = time;

        pointer.lerp(pointerTarget, 0.045);
        field.rotation.y += (pointer.x * 0.11 - field.rotation.y) * 0.035;
        field.rotation.x += (-pointer.y * 0.07 - field.rotation.x) * 0.035;
        camera.position.y += (scrollTarget * -0.45 - camera.position.y) * 0.04;

        if (!reduceMotion) {
          frames.forEach((frame, index) => {
            frame.position.z += delta * (0.42 + index * 0.008);
            if (frame.position.z > 2.1) frame.position.z -= frameCount * 1.35;
          });
          field.rotation.z += delta * 0.006;
        }

        renderer.render(scene, camera);
        if (!reduceMotion) animationFrame = requestAnimationFrame(render);
      };

      const visibilityObserver = new IntersectionObserver(entries => {
        running = entries[0]?.isIntersecting && !document.hidden;
        if (running && !reduceMotion && !animationFrame) {
          previousTime = performance.now();
          animationFrame = requestAnimationFrame(render);
        } else if (!running && animationFrame) {
          cancelAnimationFrame(animationFrame);
          animationFrame = 0;
        }
      }, { threshold: 0.01 });

      const handleVisibility = () => {
        running = !document.hidden && root.getBoundingClientRect().bottom > 0;
        if (running && !reduceMotion && !animationFrame) animationFrame = requestAnimationFrame(render);
        if (!running && animationFrame) {
          cancelAnimationFrame(animationFrame);
          animationFrame = 0;
        }
      };

      const resizeObserver = new ResizeObserver(resize);
      resizeObserver.observe(root);
      visibilityObserver.observe(root);
      window.addEventListener('pointermove', updatePointer, { passive: true, signal });
      window.addEventListener('scroll', updateScroll, { passive: true, signal });
      document.addEventListener('visibilitychange', handleVisibility, { signal });

      resize();
      updateScroll();
      render(performance.now());
      root.classList.add('is-rendering');

      disposeThreeHero = () => {
        disposed = true;
        abortController.abort();
        resizeObserver.disconnect();
        visibilityObserver.disconnect();
        if (animationFrame) cancelAnimationFrame(animationFrame);
        geometries.forEach(geometry => geometry.dispose());
        materials.forEach(material => material.dispose());
        renderer.dispose();
      };
    } catch {
      root.classList.add('is-unavailable');
      abortController.abort();
    }
  }

  document.addEventListener('astro:page-load', setupThreeHero);
  document.addEventListener('astro:before-swap', () => disposeThreeHero());
  setupThreeHero();
</script>
