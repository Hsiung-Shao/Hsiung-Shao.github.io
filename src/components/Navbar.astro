---
import { products } from '../data/products';
import projectsData from '../data/projects.json';

// 第一層只放五項,五個專案收進「專案」下拉選單(2026-11 使用者覺得七個連結太擠,之後要求補上贊助)
const menuNotes: Record<string, string> = {
  pobtools: 'POB 繁中化啟動器',
  'poe-market-zh': '交易站中文化擴充',
  'exile-appraiser': '遊戲內查價',
  'multistream-hub': '多直播同時觀看',
  'kumori-music': 'AI 原創動畫風歌曲',
};
const projectLinks = products.map(product => ({ href: `/projects/${product.slug}`, label: product.name, accent: product.accent, note: menuNotes[product.slug] ?? '' }));
const links = [
  { href: '/downloads', label: '下載數' },
  { href: '/blog', label: '文章' },
  { href: '/about', label: '關於我' },
  { href: '/support', label: '贊助' },
];
const mobileExtra = [
  { href: '/projects', label: '全部專案' },
  { href: '/activity', label: '活動紀錄' },
  { href: '/now', label: '現在在做什麼' },
  { href: '/resume', label: '履歷' },
  { href: '/contact', label: '聯絡' },
];
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
// 只有完全相同的路徑才標 aria-current,一頁只會有一個
const isCurrent = (href: string) => currentPath === href;
const inSection = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
const inProjects = inSection('/projects');
---

<header class="site-nav">
  <div class="wrap">
    <a href="/" class="brand" aria-label="熊少愆首頁">熊少愆</a>
    <nav class="nav-links" aria-label="主要導覽">
      <details class="nav-menu" data-nav-menu>
        <summary class:list={{ on: inProjects }}>專案</summary>
        <div class="nav-pop">
          {projectLinks.map(link => (
            <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
              <i style={`background: ${link.accent}`}></i>
              <span>{link.label}<small>{link.note}</small></span>
            </a>
          ))}
          <a class="nav-all" href="/projects" aria-current={isCurrent('/projects') ? 'page' : undefined}>看全部 {projectsData.length} 個專案 →</a>
        </div>
      </details>
      {links.map(link => <a href={link.href} class:list={{ on: inSection(link.href) }} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>)}
    </nav>
    <a class="btn btn-main btn-sm nav-cta" href="/#tools">下載工具</a>
    <button id="nav-toggle" class="nav-toggle" type="button" aria-label="開啟選單" aria-expanded="false" aria-controls="nav-mobile">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
<!-- 放在 header 外面:header 的 backdrop-filter 會讓裡面的 position: fixed 改以 header 為基準,選單會變成 0 高 -->
<nav id="nav-mobile" class="nav-mobile" aria-label="行動版導覽">
  {[...projectLinks, ...links, ...mobileExtra].map(link => <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>)}
</nav>

<script>
  // ClientRouter 換頁會換掉整個導覽列,所以每次都從 document 重新取當前節點
  const nodes = () => ({
    toggle: document.getElementById('nav-toggle'),
    menu: document.getElementById('nav-mobile'),
    dropdown: document.querySelector<HTMLDetailsElement>('[data-nav-menu]'),
  });
  function setMobile(open: boolean) {
    const { toggle, menu } = nodes();
    if (!toggle || !menu) return;
    toggle.setAttribute('aria-expanded', String(open));
    toggle.setAttribute('aria-label', open ? '關閉選單' : '開啟選單');
    menu.classList.toggle('is-open', open);
  }

  // 全域監聽器只掛一次(這段 script 在整個瀏覽期間只執行一次);
  // 點選單外面、按 Esc 都會關,視窗加寬到桌機版時也關掉手機選單,不然切換鈕藏起來就關不掉
  document.addEventListener('click', event => {
    const { toggle, dropdown } = nodes();
    if (toggle && toggle.contains(event.target as Node)) setMobile(toggle.getAttribute('aria-expanded') !== 'true');
    if (dropdown?.open && !dropdown.contains(event.target as Node)) dropdown.open = false;
  });
  document.addEventListener('keydown', event => {
    if (event.key !== 'Escape') return;
    const { dropdown, menu } = nodes();
    if (dropdown?.open) dropdown.open = false;
    if (menu?.classList.contains('is-open')) setMobile(false);
  });
  window.matchMedia('(min-width: 901px)').addEventListener('change', event => { if (event.matches) setMobile(false); });
</script>
