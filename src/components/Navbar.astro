---
const links = [
  { href: '/projects/pobtools', label: 'PobTools' },
  { href: '/projects/poe-market-zh', label: 'Poe Market zh' },
  { href: '/projects/exile-appraiser', label: 'ExileAppraiser' },
  { href: '/projects/multistream-hub', label: 'MultiStream' },
  { href: '/projects/kumori-music', label: 'Kumori Music' },
  { href: '/downloads', label: '下載數' },
  { href: '/blog', label: '文章' },
];
// 手機選單多放幾個桌機版收在頁尾的入口
const mobileExtra = [
  { href: '/projects', label: '全部專案' },
  { href: '/activity', label: '活動紀錄' },
  { href: '/about', label: '關於我' },
  { href: '/resume', label: '履歷' },
  { href: '/support', label: '贊助' },
];
const currentPath = Astro.url.pathname.replace(/\/$/, '') || '/';
const isActive = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="site-nav">
  <div class="wrap">
    <a href="/" class="brand" aria-label="熊少愆首頁">熊少愆</a>
    <nav class="nav-links" aria-label="主要導覽">
      {links.map(link => <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>)}
    </nav>
    <a class="btn btn-main btn-sm nav-cta" href="/#tools">下載工具</a>
    <button id="nav-toggle" class="nav-toggle" type="button" aria-label="開啟選單" aria-expanded="false" aria-controls="nav-mobile">
      <span></span><span></span><span></span>
    </button>
  </div>
</header>
<!-- 放在 header 外面:header 的 backdrop-filter 會讓裡面的 position: fixed 改以 header 為基準,選單會變成 0 高 -->
<nav id="nav-mobile" class="nav-mobile" aria-label="行動版導覽">
  {[...links, ...mobileExtra].map(link => <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>{link.label}</a>)}
</nav>

<script>
  function setupNav() {
    const toggle = document.getElementById('nav-toggle');
    const menu = document.getElementById('nav-mobile');
    if (!toggle || !menu || toggle.dataset.bound === 'true') return;
    toggle.dataset.bound = 'true';
    toggle.addEventListener('click', () => {
      const open = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? '關閉選單' : '開啟選單');
      menu.classList.toggle('is-open', open);
    });
  }
  document.addEventListener('astro:page-load', setupNav);
  setupNav();
</script>
