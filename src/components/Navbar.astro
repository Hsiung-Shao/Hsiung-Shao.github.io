---
const links = [
  { href: '/projects', code: '01', label: '專案' },
  { href: '/blog', code: '02', label: '文章' },
  { href: '/activity', code: '03', label: '活動' },
  { href: '/now', code: '04', label: '現在' },
  { href: '/about', code: '05', label: '關於' },
];
const utility = [
  { href: '/support', label: '支持' },
  { href: '/contact', label: '聯絡' },
];
const currentPath = Astro.url.pathname;
const isActive = (href: string) => currentPath === href || currentPath.startsWith(`${href}/`);
---

<header class="spatial-nav">
  <div class="spatial-nav-inner">
    <a href="/" class="spatial-brand" aria-label="熊少愆首頁">
      <span class="brand-signal" aria-hidden="true"></span>
      <span><strong>HSIUNG</strong><small>SHAO / 00</small></span>
    </a>

    <nav class="spatial-links" aria-label="主要導覽">
      {links.map(link => (
        <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}>
          <small>{link.code}</small><span>{link.label}</span>
        </a>
      ))}
    </nav>

    <nav class="spatial-utility" aria-label="次要導覽">
      {utility.map(link => <a href={link.href} class:list={{ active: isActive(link.href) }}>{link.label}</a>)}
    </nav>

    <button id="menu-toggle" class="spatial-menu-toggle" aria-label="開啟導覽" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span>
    </button>
  </div>

  <nav id="mobile-menu" class="spatial-mobile-menu" aria-label="行動版導覽">
    {[...links, ...utility.map((item, index) => ({ ...item, code: `0${index + 6}` }))].map(link => (
      <a href={link.href} aria-current={isActive(link.href) ? 'page' : undefined}><small>{link.code}</small><span>{link.label}</span></a>
    ))}
  </nav>
</header>

<script>
  function setupSpatialNav() {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    if (!toggle || !menu || toggle.dataset.bound === 'true') return;

    toggle.dataset.bound = 'true';
    toggle.addEventListener('click', () => {
      const expanded = toggle.getAttribute('aria-expanded') === 'true';
      toggle.setAttribute('aria-expanded', String(!expanded));
      toggle.setAttribute('aria-label', expanded ? '開啟導覽' : '關閉導覽');
      menu.classList.toggle('is-open', !expanded);
    });
  }

  document.addEventListener('astro:page-load', setupSpatialNav);
  setupSpatialNav();
</script>
